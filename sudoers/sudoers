# Sudoers file for the Weather4Lox plugin.
# Note: All scripts in sbin will be added automatically by LoxBerry.
%loxberry ALL = NOPASSWD: /usr/sbin/reboot, /usr/bin/systemctl stop bluetooth.service aw859a-bluetooth.service, /usr/bin/systemctl start aw859a-bluetooth.service bluetooth.service, /usr/bin/bluetoothctl, /usr/sbin/modprobe -r sprdbt_tty, /usr/sbin/modprobe -r sprdwl_ng, /usr/sbin/modprobe sprdbt_tty, /usr/sbin/modprobe sprdwl_ng  